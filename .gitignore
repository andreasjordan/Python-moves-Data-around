# demo/04_photoservice.ipynb writes a photo back out of the database to prove it survived,
# and deletes it again in the next cell. If that cell is not reached, this keeps it out.
demo/test.jpg

# configure_logging() writes every message a lib/ function emits here, so that the screen can
# stay quiet. It is a record of one run, not part of the repository.
demo/demo.log

# 05_sample_data_setup.py downloads to "<name>.part" and renames only when the file is complete.
# One left behind means a download died halfway.
data/**/*.part

data/timesheets/*.xlsx
data/projectstatus/*.xlsx
data/stackexchange/*.xml
data/geodata/*.gpx
data/geodata/*/*.gpx
data/geodata/*.geojson
