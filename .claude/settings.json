{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git check-attr:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(wsl --list:*)",
      "Bash(wsl --status)",
      "Bash(python --version)",
      "Bash(python -m compileall:*)",
      "Bash(python -m ruff check:*)",
      "Bash(python -m pip list:*)",
      "Bash(python -m pip show:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git blame:*)",
      "PowerShell(docker ps:*)",
      "PowerShell(docker logs:*)",
      "PowerShell(docker inspect:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)",
      "PowerShell(docker compose config:*)",
      "PowerShell(python --version)",
      "PowerShell(python -m compileall:*)",
      "PowerShell(python -m ruff check:*)",
      "PowerShell(python -m pip list:*)",
      "PowerShell(python -m pip show:*)",
      "PowerShell(Test-Path:*)"
    ],
    "deny": [
      "Bash(wsl --shutdown)",
      "Bash(wsl --unregister:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker volume rm:*)",
      "Bash(python -m pip install:*)",
      "Bash(jupyter:*)",
      "Bash(python -m jupyter:*)",
      "Bash(python -m nbconvert:*)",
      "Bash(python -m nbclient:*)",
      "PowerShell(wsl --shutdown)",
      "PowerShell(wsl --unregister:*)",
      "PowerShell(docker compose up:*)",
      "PowerShell(docker compose down:*)",
      "PowerShell(docker rm:*)",
      "PowerShell(docker stop:*)",
      "PowerShell(docker volume rm:*)",
      "PowerShell(python -m pip install:*)",
      "PowerShell(jupyter:*)",
      "PowerShell(python -m jupyter:*)",
      "PowerShell(python -m nbconvert:*)",
      "PowerShell(python -m nbclient:*)",
      "Read(./data/**/*.xlsx)",
      "Read(./data/**/*.xml)",
      "Read(./data/**/*.gpx)",
      "Read(./data/**/*.geojson)",
      "Read(./**/__pycache__/**)"
    ]
  }
}
